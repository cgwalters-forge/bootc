# The bootc 1.16.0 "old stager" fixture for test-49-composefs-1-16-bridge.
#
# Starts from a locally built composefs UKI image (which already carries the
# tmt dependencies), swaps in the pinned bootc 1.16.0 build, and regenerates
# the initramfs and UKI with it. This follows the v1.16.0 sealing flow: the
# kernel and initramfs stay in /usr/lib/modules and the UKI (with only the
# bare composefs= argument) goes in /boot/EFI/Linux.
#
# Build secrets required (for sealed builds):
#   secureboot_key, secureboot_cert
ARG base=localhost/bootc

FROM scratch AS packaging
COPY contrib/packaging /

# Get the kernel and initramfs back out of the current UKI
FROM ${base} AS kernel
RUN <<EORUN
set -xeuo pipefail
kver=$(bootc container inspect --rootfs / --json | jq -r '.kernel.version')
bootc internals uki extract /boot/EFI/Linux/$kver.efi /boot
EORUN

FROM ${base} AS rootfs
ARG bootc_rpm_url
ARG bootc_rpm_sha256
RUN --mount=type=tmpfs,target=/run --mount=type=tmpfs,target=/tmp \
    --mount=type=bind,from=kernel,src=/boot,target=/run/kernel <<EORUN
set -xeuo pipefail
kver=$(bootc container inspect --rootfs / --json | jq -r '.kernel.version')
curl -fsSL --retry 5 --retry-all-errors -o /tmp/bootc.rpm "${bootc_rpm_url}"
echo "${bootc_rpm_sha256}  /tmp/bootc.rpm" | sha256sum -c
# These subpackages require the exact current bootc version and aren't
# used by the stager; drop them so the downgrade keeps dependency checks.
for pkg in bootc-tests system-reinstall-bootc; do
    if rpm -q "${pkg}" >/dev/null; then rpm -e --nodeps "${pkg}"; fi
done
rpm -Uvh --oldpackage /tmp/bootc.rpm
bootc --version
# 1.16.0's ukify refuses a rootfs that already contains a UKI.
rm -f /boot/EFI/Linux/${kver}.efi /boot/${kver}.dump
install -m 0755 /run/kernel/${kver}/vmlinuz /usr/lib/modules/${kver}/vmlinuz
# Regenerate the initramfs so it carries 1.16.0's dracut module.
dracut --force --no-hostonly --reproducible --kver "${kver}" /usr/lib/modules/${kver}/initramfs.img
EORUN

FROM rootfs AS tools
RUN --mount=type=tmpfs,target=/run --mount=type=tmpfs,target=/tmp \
    --mount=type=bind,from=packaging,src=/,target=/run/packaging \
    /run/packaging/initialize-sealing-tools

# Seal the UKI with bootc 1.16.0's ukify
FROM tools AS uki
ARG seal_state=sealed
RUN --network=none --mount=type=tmpfs,target=/run --mount=type=tmpfs,target=/tmp \
    --mount=type=secret,id=secureboot_key \
    --mount=type=secret,id=secureboot_cert \
    --mount=type=bind,from=rootfs,src=/,target=/run/target <<EORUN
set -xeuo pipefail
kver=$(ls /run/target/usr/lib/modules)
ukifyargs=(--measure --json pretty --output /uki/${kver}.efi)
containerukifyargs=(--rootfs /run/target)
case "${seal_state}" in
    sealed)
        ukifyargs+=(--signtool sbsign
                    --secureboot-private-key /run/secrets/secureboot_key
                    --secureboot-certificate /run/secrets/secureboot_cert)
        ;;
    unsealed)
        containerukifyargs+=(--allow-missing-verity)
        ;;
    *)
        echo "Unknown seal_state: ${seal_state}" >&2
        exit 1
        ;;
esac
mkdir -p /uki
bootc container ukify "${containerukifyargs[@]}" -- "${ukifyargs[@]}"
EORUN

FROM rootfs
COPY --from=uki /uki/ /boot/EFI/Linux/
LABEL bootc.test.fixture=bootc-1.16.0-stager
